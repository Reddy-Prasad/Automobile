# Copy to .env (Vite reads VITE_* at startup — restart after a change).

# true  = in-memory mock (classroom). No row in Chrome Network.
# false = real HTTP to VITE_API_BASE_URL. Same services and views.
VITE_USE_MOCK=true

# Used only when VITE_USE_MOCK=false. Include the /api prefix the .NET team chose.
VITE_API_BASE_URL=https://localhost:5001/api

# Playwright and Vitest set this so the mock does not wait 450–900ms.
# VITE_MOCK_INSTANT=true
